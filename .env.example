# Local development uses safe loopback defaults; no credentials are needed.
HOST=127.0.0.1
PORT=4319
AUTH_MODE=local
DATABASE_PATH=data/signaldesk.sqlite
MAX_EVENTS=1000000
# Required only for token mode: JSON array. Generate tokens with `npm run credentials`.
# ACCESS_TOKENS=[{"token":"replace-with-32-or-more-random-characters","role":"admin","workspaces":["live","demo"],"name":"operator"}]
# CHANNEL_KEY=replace-with-64-hex-characters
# Optional private destinations, explicit exact hostname allowlist (comma-separated).
# ALLOWED_DESTINATION_HOSTS=internal-api.example.org

# Shared PostgreSQL (split roles require PostgreSQL):
# STORAGE_BACKEND=postgres
# DATABASE_URL=postgres://signaldesk:password@localhost:5432/signaldesk
# APP_ROLE=api
# PG_POOL_SIZE=10
# COLLECT_LOCAL=false
# REQUIRE_RESOURCE_IDENTITY=true
# SEED_DEMO=false
# POSTGRES_PASSWORD=generate-with-npm-run-credentials
MAX_RESOURCES=20000
# Platform process identity (external producers set their own resource fields):
# ENVIRONMENT=production
# MODULE=monitoring
# REGION=ap-northeast-2
# ZONE=ap-northeast-2a
# CLUSTER=observability-prod
# NAMESPACE=monitoring
# INSTANCE_ID=unique-pod-uid

# Trust only an actual reverse proxy IP/CIDR. Empty means forwarded headers are ignored.
# TRUSTED_PROXIES=172.31.240.10
# Optional operator-approved HTTPS diagnosis gateway (off by default).
# AI_DIAGNOSIS_ENABLED=false
# AI_DIAGNOSIS_URL=https://diagnosis.example.org/v1/analyze
# AI_DIAGNOSIS_TOKEN=managed-secret
