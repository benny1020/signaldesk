# Local development uses safe loopback defaults; no credentials are needed.
HOST=127.0.0.1
PORT=4319
AUTH_MODE=local
DATABASE_PATH=data/signaldesk.sqlite
MAX_EVENTS=1000000
# Required only for token mode: JSON array. Generate tokens with `npm run credentials`.
# ACCESS_TOKENS=[{"token":"replace-with-32-or-more-random-characters","role":"admin","workspaces":["live","demo"],"name":"operator"}]
# CHANNEL_KEY=replace-with-64-hex-characters
# Optional private destinations, explicit exact hostname allowlist (comma-separated).
# ALLOWED_DESTINATION_HOSTS=internal-api.example.org
